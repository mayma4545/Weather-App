# ──────────────────────────────────────────────────
# DEBESMSCAT Weather & Smart Crop Platform — env template
# Copy to .env and fill values. Never commit real secrets.
# ──────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development
SESSION_SECRET=

# Database (dev SQLite / prod MySQL)
DB_FILE=database.sqlite
# PROD_DATABASE_URL=
# PROD_DB_HOST=
# PROD_DB_PORT=
# PROD_DB_NAME=
# PROD_DB_USER=
# PROD_DB_PASSWORD=

# OpenWeather (campus weather)
OPENWEATHER_API_KEY=
WEATHER_LAT=12.3703
WEATHER_LON=123.6217

# Email (Gmail SMTP)
EMAIL_USER=
EMAIL_PASS=

# Cloudinary (crop images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# MAX_FILE_SIZE=10485760
# ALLOWED_IMAGE_TYPES=jpeg,jpg,png,gif,webp

# Google AI / Gemini — Actionable Field Recommendations (server-side only)
GOOGLE_AI_API_KEY=
# Alternate accepted name:
# GEMINI_API_KEY=
# Optional model override (default gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
